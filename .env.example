# Client (safe to expose, protected by RLS)
VITE_SUPABASE_URL=https://YOURPROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Seeding only. Never commit, never ship to the browser.
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth for Supabase Auth. Configure these in the Supabase dashboard under
# Authentication > Providers > Google (or via the Management API), NOT in the browser.
# The app never reads them; they are documented here for setup only. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
